server {
    listen 80;
    listen [::]:80;

    server_name eride.africa www.eride.africa;

    # 这里指向你上传 dist 文件的目录
    root /var/www/eride.africa;
    index index.html;

    # 对于 SPA（哪怕是 hash 路由），都让入口走 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 可选：静态资源缓存（不是必须）
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
        try_files $uri =404;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}

